---
import Arrow from "~/components/ui/arrow.astro";

// Two variants only. `solid` is the single loud call to action per screen;
// `ghost` is everything else.
interface Props {
   href: string;
   variant?: "solid" | "ghost";
   arrow?: "up-right" | "down-right";
   class?: string;
}

const {
   href,
   variant = "solid",
   arrow = "up-right",
   class: className = "",
} = Astro.props;

const base =
   "label group inline-flex items-center gap-3 transition";

const variants = {
   solid:
      "bg-accent px-5 py-4 text-void hover:-translate-y-0.5 hover:bg-ink focus-visible:-translate-y-0.5",
   ghost:
      "border border-line px-5 py-4 text-ink hover:border-accent hover:text-accent",
};
---

<a class:list={[base, variants[variant], className]} href={href}>
   <slot />
   <Arrow
      dir={arrow}
      class="transition-transform group-hover:translate-x-0.5"
   />
</a>
