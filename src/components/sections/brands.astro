---
import { Image } from "astro:assets";
import Marquee from "~/components/ui/marquee.astro";
import { brands } from "~/components/sections/data";

const half = Math.ceil(brands.length / 2);
const rows = [brands.slice(0, half), brands.slice(half)];
---

<section class="shell py-block" aria-label="Brands worked with">
   <p class="label flex items-center gap-3 text-faint">
      <span class="size-1.5 shrink-0 bg-accent"></span>Brands in the room
   </p>

   <div class="mt-stack space-y-4">
      {
         rows.map((row, rowIndex) => (
            <Marquee duration={72 + rowIndex * 16} reverse={rowIndex === 1}>
               {[0, 1].map((copy) =>
                  row.map((brand) => (
                     <div
                        class="group aspect-3/2 w-56 shrink-0 overflow-hidden border border-line-soft bg-ink transition-colors hover:border-accent sm:w-64"
                        aria-hidden={copy === 1 ? "true" : null}
                     >
                        <Image
                           src={brand.logo}
                           alt={copy === 1 ? "" : `${brand.name} logo`}
                           width={432}
                           height={288}
                           densities={[1, 2]}
                           loading="lazy"
                           decoding="async"
                           class="h-full w-full object-contain mix-blend-multiply transition-transform duration-slow group-hover:scale-105"
                        />
                     </div>
                  )),
               )}
            </Marquee>
         ))
      }
   </div>
</section>
