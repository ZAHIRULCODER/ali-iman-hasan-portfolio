---
import Arrow from "~/components/ui/arrow.astro";
import Eyebrow from "~/components/ui/eyebrow.astro";
import Section from "~/components/ui/section.astro";

const phones = ["+91 98740 20939", "+91 70032 28236"];
const email = "aliimanhassan9874@gmail.com";
---

<Section id="contact" as="footer" class="pb-block">
   <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
      <Eyebrow index="06">Let’s make something</Eyebrow>
      <span class="label inline-flex items-center gap-2 text-accent">
         <span class="size-1.5 rounded-full bg-accent"></span>Open to the right
         brief
      </span>
   </div>

   <div class="py-block">
      <h2 class="text-display-xl">
         Have a brief<br /><span class="text-accent">with a pulse?</span>
      </h2>

      <a
         class="group mt-block inline-flex max-w-full items-center gap-3 border-b border-accent pb-2 text-quote text-ink transition-colors hover:text-accent"
         href={`mailto:${email}`}
      >
         <span class="truncate">{email}</span>
         <Arrow
            class="shrink-0 text-accent transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
         />
      </a>

      <ul class="label mt-stack flex flex-wrap gap-x-6 gap-y-2 text-muted">
         {
            phones.map((phone) => (
               <li>
                  <a
                     class="transition-colors hover:text-accent"
                     href={`tel:${phone.replace(/\s/g, "")}`}
                  >
                     {phone}
                  </a>
               </li>
            ))
         }
      </ul>
   </div>

   <div
      class="label flex flex-col items-start gap-3 border-t border-line pt-5 text-faint sm:flex-row sm:items-center sm:justify-between"
   >
      <span>Ali Iman Hassan / AI creative portfolio</span>
      <span>© 2026</span>
   </div>
</Section>
