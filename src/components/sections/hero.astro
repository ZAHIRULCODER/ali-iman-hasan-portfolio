---
import { Image } from "astro:assets";
import Button from "~/components/ui/button.astro";
import Eyebrow from "~/components/ui/eyebrow.astro";
import { heroImage } from "~/components/sections/data";
---

<section
   class="shell relative grid items-center gap-block py-section lg:grid-cols-12"
   id="top"
   aria-labelledby="hero-title"
>
   <div
      class="pointer-events-none absolute -right-40 -top-40 -z-10 size-[32rem] rounded-full bg-accent/[0.06] blur-3xl"
      aria-hidden="true"
   >
   </div>

   <div class="relative z-10 lg:col-span-7">
      <Eyebrow index="01">Creative operator / West Bengal, India</Eyebrow>
      <h1 id="hero-title" class="mt-stack text-display-xl">
         Ideas,<br /><span class="text-accent">with range.</span>
      </h1>
      <p class="mt-stack max-w-xl text-lede text-muted">
         I’m Ali — an AI strategist, content manager, and filmmaker building
         work that starts with a sharp thought and lands as something people can
         feel.
      </p>
      <div class="mt-block flex flex-wrap items-center gap-4">
         <Button href="#work" arrow="down-right">Explore selected work</Button>
         <Button href="#contact" variant="ghost" arrow="down-right">
            Start a conversation
         </Button>
      </div>
   </div>

   <div class="relative lg:col-span-5">
      <div class="relative aspect-3/4 overflow-hidden border border-line bg-surface">
         <Image
            class="h-full w-full object-cover saturate-[0.85] contrast-110"
            src={heroImage}
            width={760}
            densities={[1, 2]}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            alt="Ali Iman Hassan working on his phone at a café table"
         />
         <div
            class="pointer-events-none absolute inset-0 bg-linear-to-t from-void via-void/10 to-transparent"
            aria-hidden="true"
         >
         </div>
         <div
            class="pointer-events-none absolute inset-4 border border-ink/15"
            aria-hidden="true"
         >
         </div>
      </div>
   </div>
</section>
