---
import { Image } from "astro:assets";
import Eyebrow from "~/components/ui/eyebrow.astro";
import Marquee from "~/components/ui/marquee.astro";
import SectionHeading from "~/components/ui/section-heading.astro";
import Section from "~/components/ui/section.astro";
import { featuredFilms, selectedWork } from "~/components/sections/data";
---

<Section id="work" labelledby="work-title">
   <SectionHeading
      index="03"
      eyebrow="Selected work"
      id="work-title"
      lede="Campaigns, content systems, films, and visual worlds — built for brands that need more than output."
   >
      Work with<br /><span class="text-accent">a point of view.</span>
   </SectionHeading>

   <div class="mt-block">
      <Eyebrow>Featured films — watch the work in motion</Eyebrow>
      <div class="mt-stack grid gap-stack lg:grid-cols-2">
         {
            featuredFilms.map((film) => (
               <figure>
                  <div class="aspect-video overflow-hidden border border-line bg-surface">
                     <iframe
                        class="h-full w-full"
                        src={`https://www.youtube-nocookie.com/embed/${film.id}?rel=0`}
                        title={`${film.title} — ${film.client}`}
                        loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen
                     />
                  </div>
                  <figcaption class="label mt-4 flex items-center justify-between gap-4 border-t border-line pt-3">
                     <span class="text-accent">{film.client}</span>
                     <span class="text-faint">{film.note}</span>
                  </figcaption>
               </figure>
            ))
         }
      </div>
   </div>
   <div class="mt-block" aria-label="Selected work carousel">
      <Marquee duration={58} gap="2rem" fade="4%" class="pb-4">
         {
            [...selectedWork, ...selectedWork].map((project, index) => {
               const isClone = index >= selectedWork.length;
               const projectNumber = String(
                  (index % selectedWork.length) + 1,
               ).padStart(2, "0");

               return (
                  <article
                     class="w-[min(78vw,32rem)] shrink-0"
                     aria-hidden={isClone ? "true" : undefined}
                  >
                     <a
                        class="group relative block aspect-4/3 overflow-hidden border border-line bg-surface"
                        href="#contact"
                        aria-label={`Talk about ${project.client}: ${project.title}`}
                        tabindex={isClone ? -1 : undefined}
                     >
                        <Image
                           class="h-full w-full object-contain saturate-[0.8] transition duration-slow group-hover:scale-[1.03] group-hover:saturate-100"
                           src={project.image}
                           loading="lazy"
                           decoding="async"
                           alt={project.alt}
                        />
                        <div
                           class="pointer-events-none absolute inset-0 bg-linear-to-t from-void/80 to-transparent"
                           aria-hidden="true"
                        />
                     </a>
                     <div class="mt-5 border-t border-line pt-3">
                        <div class="label flex items-center justify-between text-accent">
                           <span>{project.client}</span>
                           <span class="text-faint">{projectNumber}</span>
                        </div>
                        <h3 class="mt-3 text-display-md text-ink">
                           {project.title}
                        </h3>
                        <p class="mt-3 text-muted">{project.description}</p>
                        <div class="label mt-4 flex flex-wrap gap-2 text-faint">
                           {project.tags.map((tag) => (
                              <span class="border border-line px-2.5 py-1.5">
                                 {tag}
                              </span>
                           ))}
                        </div>
                     </div>
                  </article>
               );
            })
         }
      </Marquee>
   </div>
</Section>
