---
const links = [
   { href: "#work", label: "Work" },
   { href: "#system", label: "System" },
   { href: "#contact", label: "Contact" },
];
---

<header
   class="sticky top-0 z-30 border-b border-line bg-void/80 backdrop-blur-xl"
>
   <div class="shell flex min-h-16 items-center justify-between gap-4 lg:min-h-20">
      <a
         class="label group inline-flex items-center gap-3 text-ink"
         href="#top"
         aria-label="Ali Iman Hassan home"
      >
         <span
            class="grid size-7 place-items-center border border-accent text-accent transition-colors group-hover:bg-accent group-hover:text-void"
            >AI</span
         >
         <span class="hidden whitespace-nowrap sm:inline">Ali Iman Hassan</span>
      </a>
      <nav
         class="label flex items-center gap-5 text-muted sm:gap-8"
         aria-label="Primary navigation"
      >
         {
            links.map((link) => (
               <a
                  class="relative py-1 transition-colors hover:text-ink after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-accent after:transition-transform hover:after:scale-x-100"
                  href={link.href}
               >
                  {link.label}
               </a>
            ))
         }
      </nav>
   </div>
</header>
