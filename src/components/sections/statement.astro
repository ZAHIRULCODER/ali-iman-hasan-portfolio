---
import { Image } from "astro:assets";
import SectionHeading from "~/components/ui/section-heading.astro";
import Section from "~/components/ui/section.astro";
import { tools } from "~/components/sections/data";

const logoTools = tools.filter((tool) => tool.logo);
---

<Section id="statement" labelledby="statement-title">
   <SectionHeading
      index="02"
      eyebrow="Point of view"
      id="statement-title"
      lede="The tool can give me ten directions. My work is knowing which one has a pulse, then carrying it all the way from the first line of copy to the final frame."
   >
      AI is the multiplier.<br /><span class="text-muted"
         >Judgement is the job.</span
      >
   </SectionHeading>

   <ul
      class="mt-block grid grid-cols-2 border-l border-t border-line-soft sm:grid-cols-4"
      aria-label="Tools I work with"
   >
      {
         logoTools.map((tool) => (
            <li class="group flex aspect-3/2 items-center justify-center border-b border-r border-line-soft p-6 transition-colors hover:bg-surface">
               <Image
                  src={tool.logo!}
                  alt={`${tool.name} logo`}
                  width={320}
                  height={213}
                  densities={[1, 2]}
                  loading="lazy"
                  decoding="async"
                  class="tool-logo h-full w-full object-contain opacity-85 transition duration-slow group-hover:scale-105 group-hover:opacity-100"
               />
            </li>
         ))
      }
   </ul>

   <p class="label mt-stack flex items-center gap-3 text-faint">
      <span class="h-px w-7 shrink-0 bg-accent"></span>Think / direct / make /
      learn
   </p>
</Section>

<style>
   /* Source logos are dark marks on a white background. Grayscale + invert
      flips them to white on black, and screen blending drops the black so the
      mark sits directly on the page instead of inside a bright white card.
      This needs an opaque backdrop inside the nearest isolation context —
      <main> carries `isolate`, so it must also carry `bg-void` or the black
      has nothing to blend into and stays visible as a box. */
   .tool-logo {
      filter: grayscale(1) invert(1) contrast(1.35) brightness(1.15);
      mix-blend-mode: screen;
   }
</style>
