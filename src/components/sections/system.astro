---
import Arrow from "~/components/ui/arrow.astro";
import SectionHeading from "~/components/ui/section-heading.astro";
import Section from "~/components/ui/section.astro";
import { tools, workflow } from "~/components/sections/data";
---

<Section id="system" labelledby="system-title">
   <SectionHeading
      index="04"
      eyebrow="The system"
      id="system-title"
      lede="Every brief moves through the same discipline. The tools change. The thinking stays accountable."
   >
      A production line<br /><span class="text-accent">for better ideas.</span>
   </SectionHeading>

   <div
      class="mt-block grid grid-cols-1 border-l border-t border-line sm:grid-cols-2 lg:grid-cols-4"
   >
      {
         workflow.map((item) => (
            <article class="group flex h-full flex-col justify-between gap-block border-b border-r border-line p-5 transition-colors hover:bg-surface lg:p-6">
               <span class="label text-accent">{item.step}</span>
               <div>
                  <h3 class="text-display-sm text-ink">{item.title}</h3>
                  <p class="mt-3 text-muted">{item.body}</p>
               </div>
            </article>
         ))
      }
   </div>

   <div
      class="mt-stack flex flex-col gap-4 border-t border-line-soft pt-5 lg:flex-row"
   >
      <span class="label shrink-0 text-faint lg:w-48">Current toolchain</span>
      <ul class="label flex flex-wrap gap-x-5 gap-y-2 text-muted">
         {
            tools.map((tool) => (
               <li class="flex items-center gap-2">
                  <Arrow class="text-accent" />
                  {tool.name}
               </li>
            ))
         }
      </ul>
   </div>
</Section>
