---
import { stats } from "~/components/sections/data";
---

<section aria-label="Career highlights">
   <div class="shell grid grid-cols-2 border-y border-line lg:grid-cols-5">
      <div
         class="label col-span-2 flex items-center gap-3 py-5 text-faint lg:col-span-1 lg:py-8 lg:pr-6"
      >
         <span class="size-1.5 shrink-0 bg-accent"></span>Selected proof
      </div>
      {
         stats.map((stat) => (
            <div class="flex min-h-28 flex-col justify-between gap-6 border-t border-line py-5 pr-4 lg:min-h-36 lg:border-l lg:border-t-0 lg:py-8 lg:pl-6">
               <strong class="text-stat font-display font-medium text-ink">
                  {stat.value}
               </strong>
               <span class="label text-muted">{stat.label}</span>
            </div>
         ))
      }
   </div>
</section>
