---
import { flowLinks } from "~/components/sections/data";
---

<section
   class="mx-auto grid w-full max-w-7xl border-b border-line px-5 py-8 lg:grid-cols-5 lg:px-12"
   aria-label="Page flow"
>
   <div
      class="mb-5 flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-faint lg:col-span-1 lg:mb-0"
   >
      <span class="text-acid">↘</span>Navigate the work
   </div>
   <nav
      class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:col-span-4"
      aria-label="Section navigation"
   >
      {
         flowLinks.map((link) => (
            <a
               class="group border-t border-line pt-3 transition-colors hover:border-acid"
               href={link.href}
            >
               <span aria-hidden="true" class="font-mono text-lg leading-none text-acid transition-transform group-hover:translate-x-1">↗</span>
               <span class="mt-2 block font-display text-2xl font-semibold uppercase leading-none text-ink transition-colors group-hover:text-acid">
                  {link.label}
               </span>
            </a>
         ))
      }
   </nav>
</section>
