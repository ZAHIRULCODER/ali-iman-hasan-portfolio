---
import { principles } from "~/components/sections/data";
---

<section
   class="mx-auto w-full max-w-7xl px-5 pt-32 lg:px-12 lg:pt-40"
   aria-labelledby="principles-title"
>
   <div
      class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-faint"
   >
      <span class="text-acid">05</span><span class="h-px w-7 bg-acid"
      ></span>Working principles
   </div>
   <div class="mt-10 border-y border-line">
      <div class="grid lg:grid-cols-12">
         <div
            class="flex flex-col justify-between gap-12 border-b border-line px-5 py-8 sm:px-6 lg:col-span-5 lg:border-b-0 lg:border-r lg:pl-0 lg:pr-8 lg:py-10"
         >
            <h2
               id="principles-title"
               class="font-display text-4xl font-semibold uppercase leading-none tracking-normal text-ink sm:text-6xl lg:text-7xl"
            >
               Make it<br /><em class="not-italic text-acid"
                  >mean something.</em>
            </h2>
            <div
               class="flex items-center justify-between border-t border-line-soft pt-4 font-mono text-xs uppercase tracking-widest text-faint"
            >
               <span>04 principles</span><span class="text-acid"
                  >Keep it sharp</span>
            </div>
         </div>
         <ol
            class="flex flex-col lg:col-span-7"
            aria-label="Working principles"
         >
            {
               principles.map((principle, index) => (
                  <li class="grid flex-1 grid-cols-12 items-center gap-4 border-b border-line px-5 py-5 last:border-b-0 sm:px-6 sm:py-6 lg:px-8">
                     <span class="col-span-2 font-mono text-xs text-acid">
                        {String(index + 1).padStart(2, "0")}
                     </span>
                     <p class="col-span-10 text-lg leading-relaxed text-ink sm:text-xl lg:text-2xl">
                        {principle}
                     </p>
                  </li>
               ))
            }
         </ol>
      </div>
   </div>
</section>
