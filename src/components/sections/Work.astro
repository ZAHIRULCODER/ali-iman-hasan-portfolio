---
import { Image } from "astro:assets";
import { selectedWork } from "~/components/sections/data";

const trackItems = [...selectedWork, ...selectedWork];
---

<section
   class="mx-auto w-full max-w-7xl scroll-mt-24 px-5 pt-32 lg:px-12 lg:pt-40"
   id="work"
   aria-labelledby="work-title"
>
   <div
      class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-faint"
   >
      <span class="text-acid">03</span><span class="h-px w-7 bg-acid"
      ></span>Selected work
   </div>
   <div class="mt-8 grid gap-7 lg:grid-cols-2 lg:items-end lg:gap-16">
      <h2
         id="work-title"
         class="font-display text-5xl font-semibold uppercase leading-none tracking-normal text-ink sm:text-7xl lg:text-8xl"
      >
         Work with<br /><em class="not-italic text-acid">a point of view.</em>
      </h2>
      <p class="max-w-sm text-lg leading-relaxed text-muted">
         Campaigns, content systems, films, and visual worlds — built for brands
         that need more than output.
      </p>
   </div>
   <div
      class="portfolio-slider relative mt-14 overflow-hidden lg:mt-20"
      aria-label="Selected work carousel"
   >
      <div class="portfolio-track flex w-max gap-8 pb-4">
         {
            trackItems.map((project, index) => {
               const isClone = index >= selectedWork.length;
               const projectNumber = String(
                  (index % selectedWork.length) + 1,
               ).padStart(2, "0");

               return (
                  <article
                     class="portfolio-slide w-[min(78vw,34rem)] shrink-0 sm:w-[min(52vw,38rem)]"
                     aria-hidden={isClone ? "true" : undefined}
                  >
                     <a
                        class="group relative block aspect-[4/3] overflow-hidden bg-void-soft"
                        href="#contact"
                        aria-label={
                           "Talk about " + project.client + ": " + project.title
                        }
                        tabindex={isClone ? -1 : undefined}
                     >
                        <Image
                           class="h-full w-full object-contain saturate-75 transition duration-700 ease-out group-hover:saturate-100"
                           src={project.image}
                           loading="lazy"
                           decoding="async"
                           alt={project.alt}
                        />
                        <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent to-void/80" />
                        <span class="absolute bottom-4 right-4 z-10 inline-flex translate-y-2 items-center gap-2 font-mono text-xs uppercase tracking-widest text-ink opacity-0 transition duration-300 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100">
                           View case <span class="text-base">↗</span>
                        </span>
                     </a>
                     <div class="mt-5 border-t border-line pt-3">
                        <div class="flex items-center justify-between font-mono text-xs uppercase tracking-widest text-acid">
                           <span>{project.client}</span>
                           <span class="text-faint">{projectNumber}</span>
                        </div>
                        <h3 class="mt-3 font-display text-3xl font-semibold uppercase leading-tight tracking-normal text-ink lg:text-5xl">
                           {project.title}
                        </h3>
                        <p class="mt-3 max-w-lg text-sm leading-relaxed text-muted">
                           {project.description}
                        </p>
                        <div class="mt-4 flex flex-wrap gap-2 font-mono text-xs uppercase tracking-wide text-faint">
                           {project.tags.map((tag) => (
                              <span class="border border-line px-2 py-1.5">
                                 {tag}
                              </span>
                           ))}
                        </div>
                     </div>
                  </article>
               );
            })
         }
      </div>
   </div>
</section>

<style>
   .portfolio-slider {
      -webkit-mask-image: linear-gradient(
         to right,
         transparent,
         black 5%,
         black 95%,
         transparent
      );
      mask-image: linear-gradient(
         to right,
         transparent,
         black 5%,
         black 95%,
         transparent
      );
   }

   .portfolio-track {
      animation: portfolio-marquee 58s linear infinite;
   }

   .portfolio-slider:hover .portfolio-track,
   .portfolio-slider:focus-within .portfolio-track {
      animation-play-state: paused;
   }

   @keyframes portfolio-marquee {
      from {
         transform: translateX(0);
      }

      to {
         transform: translateX(calc(-50% - 1rem));
      }
   }

   @media (prefers-reduced-motion: reduce) {
      .portfolio-track {
         animation: none;
      }
   }
</style>
