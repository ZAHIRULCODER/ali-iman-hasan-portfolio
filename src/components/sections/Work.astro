---
import { Image } from "astro:assets";
import { selectedWork } from "~/components/sections/data";
---

<section class="mx-auto w-full max-w-7xl scroll-mt-24 px-5 pt-32 lg:px-16 lg:pt-56" id="work" aria-labelledby="work-title">
	<div class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-faint"><span class="text-acid">03</span><span class="h-px w-7 bg-acid"></span>Selected work</div>
	<div class="mt-8 grid gap-7 lg:grid-cols-2 lg:items-end lg:gap-16">
		<h2 id="work-title" class="font-display text-7xl uppercase leading-none tracking-normal text-ink sm:text-8xl lg:text-9xl">Work with<br /><em class="not-italic text-acid">a point of view.</em></h2>
		<p class="max-w-sm text-lg leading-relaxed text-muted">Campaigns, content systems, films, and visual worlds — built for brands that need more than output.</p>
	</div>
	<div class="mt-14 grid gap-16 md:grid-cols-2 md:gap-x-8 md:gap-y-28 lg:mt-20 lg:gap-x-12 lg:gap-y-28">
		{selectedWork.map((project, index) => (
			<article class:list={[project.wide ? "md:col-span-2" : "", index % 2 === 1 ? "md:translate-y-14" : ""]}>
				<a class:list={["group relative block overflow-hidden bg-void-soft", project.wide ? "aspect-video" : "aspect-square md:aspect-video"]} href="#contact" aria-label={"Talk about " + project.client + ": " + project.title}>
					<Image class="h-full w-full object-cover saturate-75 transition duration-700 ease-out group-hover:scale-105 group-hover:saturate-100" src={project.image} loading={index < 3 ? "eager" : "lazy"} alt={project.alt} />
					<div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent to-void/80"></div>
					<span class="absolute bottom-4 right-4 z-10 inline-flex translate-y-2 items-center gap-2 font-mono text-xs uppercase tracking-widest text-ink opacity-0 transition duration-300 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100">View case <span class="text-base">↗</span></span>
				</a>
				<div class="pt-4">
					<div class="flex justify-between font-mono text-xs uppercase tracking-widest text-acid"><span>{project.client}</span><span class="text-faint">{String(index + 1).padStart(2, "0")}</span></div>
					<h3 class="mt-3 max-w-2xl font-display text-4xl uppercase leading-tight tracking-normal text-ink lg:text-6xl">{project.title}</h3>
					<p class="mt-3 max-w-lg text-sm leading-relaxed text-muted">{project.description}</p>
					<div class="mt-4 flex flex-wrap gap-2 font-mono text-xs uppercase tracking-wide text-faint">
						{project.tags.map((tag) => <span class="border border-line px-2 py-1.5">{tag}</span>)}
					</div>
				</div>
			</article>
		))}
	</div>
</section>

