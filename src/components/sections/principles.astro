---
import SectionHeading from "~/components/ui/section-heading.astro";
import Section from "~/components/ui/section.astro";
import { principles } from "~/components/sections/data";
---

<Section labelledby="principles-title">
   <SectionHeading index="05" eyebrow="Working principles" id="principles-title">
      Make it<br /><span class="text-accent">mean something.</span>
   </SectionHeading>

   <ol class="mt-block border-t border-line" aria-label="Working principles">
      {
         principles.map((principle, index) => (
            <li class="flex items-baseline gap-6 border-b border-line py-6 lg:gap-12">
               <span class="label shrink-0 text-accent">
                  {String(index + 1).padStart(2, "0")}
               </span>
               <p class="text-quote text-ink">{principle}</p>
            </li>
         ))
      }
   </ol>

   <p class="label mt-stack flex items-center justify-between gap-4 text-faint">
      <span>{String(principles.length).padStart(2, "0")} principles</span>
      <span class="text-accent">Keep it sharp</span>
   </p>
</Section>
