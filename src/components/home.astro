---
import Brands from "~/components/sections/brands.astro";
import Contact from "~/components/sections/contact.astro";
import FlowNav from "~/components/sections/flow-nav.astro";
import Header from "~/components/sections/header.astro";
import Hero from "~/components/sections/hero.astro";
import Principles from "~/components/sections/principles.astro";
import Statement from "~/components/sections/statement.astro";
import Stats from "~/components/sections/stats.astro";
import System from "~/components/sections/system.astro";
import Work from "~/components/sections/work.astro";
---

<a
   class="label fixed left-4 top-4 z-50 -translate-y-32 bg-accent px-4 py-3 text-void transition-transform focus:translate-y-0"
   href="#work">Skip to selected work</a
>

<Header />

<main class="relative isolate overflow-clip bg-void">
   <div
      class="pointer-events-none absolute inset-y-0 left-1/2 z-0 w-full max-w-shell -translate-x-1/2 border-x border-line-soft"
      aria-hidden="true"
   >
   </div>

   <Hero />
   <Brands />
   <Stats />
   <FlowNav />
   <Statement />
   <Work />
   <System />
   <Principles />
   <Contact />
</main>
