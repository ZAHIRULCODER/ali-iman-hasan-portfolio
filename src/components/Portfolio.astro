---
import { Image } from 'astro:assets';
import portfolio01 from '../assets/portfolio/portfolio-01.jpg';
import portfolio02 from '../assets/portfolio/portfolio-02.jpg';
import portfolio03 from '../assets/portfolio/portfolio-03.jpg';
import portfolio04 from '../assets/portfolio/portfolio-04.jpg';
import portfolio05 from '../assets/portfolio/portfolio-05.jpg';
import portfolio06 from '../assets/portfolio/portfolio-06.jpg';
import portfolio07 from '../assets/portfolio/portfolio-07.jpg';
import portfolio08 from '../assets/portfolio/portfolio-08.jpg';
import portfolio09 from '../assets/portfolio/portfolio-09.jpg';
import portfolio10 from '../assets/portfolio/portfolio-10.jpg';
import portfolio11 from '../assets/portfolio/portfolio-11.jpg';
import portfolio12 from '../assets/portfolio/portfolio-12.jpg';
import portfolio13 from '../assets/portfolio/portfolio-13.jpg';
import portfolio14 from '../assets/portfolio/portfolio-14.jpg';
import portfolio15 from '../assets/portfolio/portfolio-15.jpg';
import portfolio16 from '../assets/portfolio/portfolio-16.jpg';
import portfolio17 from '../assets/portfolio/portfolio-17.jpg';
import portfolio18 from '../assets/portfolio/portfolio-18.jpg';
import portfolio19 from '../assets/portfolio/portfolio-19.jpg';
import portfolio20 from '../assets/portfolio/portfolio-20.jpg';
import portfolio21 from '../assets/portfolio/portfolio-21.jpg';
import portfolio22 from '../assets/portfolio/portfolio-22.jpg';
import portfolio23 from '../assets/portfolio/portfolio-23.jpg';
const portfolioImages = [portfolio01, portfolio02, portfolio03, portfolio04, portfolio05, portfolio06, portfolio07, portfolio08, portfolio09, portfolio10, portfolio11, portfolio12, portfolio13, portfolio14, portfolio15, portfolio16, portfolio17, portfolio18, portfolio19, portfolio20, portfolio21, portfolio22, portfolio23];
---

<div class="viewport" id="viewport">
<div class="stage" id="stage">

  <div class="marks"><span class="tl"></span><span class="tr"></span><span class="bl"></span><span class="br"></span></div>
  <div class="hud hud-name">ALI IMAN HASSAN &nbsp;/&nbsp; <b>AI CREATIVE PORTFOLIO</b></div>
  <div class="hud hud-tc"><span class="rec"></span><span id="tc">00:00:00:00</span></div>
  <div class="rail"><span>AI STRATEGIST × CONTENT MANAGER × AI FILMMAKER</span></div>
  <div class="thread"></div>

  <!-- ============ 01 OPENING ============ -->
  <section class="slide on" data-ch="01" data-label="Opening">
    <div style="position:absolute;inset:0;overflow:hidden;z-index:0">
      <div style="position:absolute;width:900px;height:900px;left:58%;top:-30%;border-radius:50%;
        background:radial-gradient(circle,rgba(61,123,255,.16),transparent 62%);filter:blur(10px)"></div>
      <div style="position:absolute;width:620px;height:620px;left:44%;top:34%;border-radius:50%;
        background:radial-gradient(circle,rgba(138,92,246,.14),transparent 64%)"></div>
      <svg width="100%" height="100%" style="position:absolute;inset:0;opacity:.5" viewBox="0 0 1600 900" preserveAspectRatio="none">
        <g stroke="rgba(126,157,224,.20)" fill="none">
          <path d="M1180 120 L1330 250 L1240 470 L1420 560 L1290 760"/>
          <path d="M1180 120 L1420 210 L1420 560"/>
          <path d="M1330 250 L1240 470 L1120 620 L1290 760"/>
          <path d="M1030 320 L1240 470 L1120 620"/>
          <path d="M1030 320 L1180 120"/>
        </g>
        <g fill="#7FA6FF">
          <circle cx="1180" cy="120" r="3.5"/><circle cx="1330" cy="250" r="3"/><circle cx="1240" cy="470" r="4.5"/>
          <circle cx="1420" cy="560" r="3"/><circle cx="1290" cy="760" r="3"/><circle cx="1420" cy="210" r="2.5"/>
          <circle cx="1120" cy="620" r="3"/><circle cx="1030" cy="320" r="2.5"/>
        </g>
        <g stroke="rgba(138,92,246,.5)" fill="none" stroke-width="1">
          <rect x="1090" y="700" width="60" height="34"/><rect x="1160" y="700" width="60" height="34"/>
          <rect x="1230" y="700" width="60" height="34"/><rect x="1300" y="700" width="60" height="34"/>
        </g>
      </svg>
    </div>
    <div style="position:relative;z-index:2;height:100%;display:flex;flex-direction:column;justify-content:center;max-width:1010px">
      <div class="eyebrow r">Portfolio <em>/ 2026</em> <em>—</em> Kolkata, India</div>
      <h1 class="d r grad" style="font-size:134px">AI Creative<br>Portfolio</h1>
      <div class="r" style="margin-top:34px;display:flex;align-items:center;gap:18px;flex-wrap:wrap">
        <span class="chip on">AI Strategist</span><span class="tiny">×</span>
        <span class="chip on">Content Manager</span><span class="tiny">×</span>
        <span class="chip on">AI Filmmaker</span>
      </div>
      <div class="r" style="margin-top:38px;display:flex;gap:26px;align-items:flex-start">
        <div style="width:2px;align-self:stretch;background:linear-gradient(180deg,var(--blue),var(--violet))"></div>
        <p style="font-family:var(--disp);font-size:30px;line-height:1.24;letter-spacing:.02em;text-transform:uppercase;max-width:760px">
          I don't just use AI to create.<br>I use AI to <span class="blue">think</span>, <span class="blue">build</span>, <span class="vio">create</span> and <span class="vio">scale</span>.</p>
      </div>
      <p class="lede r" style="margin-top:30px;max-width:560px">AI is not just a tool I use. It is part of how I work — running quietly through every brief, every idea, every frame and every post I ship.</p>
    </div>
  </section>

  <!-- ============ 02 OPERATOR ============ -->
  <section class="slide" data-ch="01" data-label="The Operator">
    <div class="eyebrow r">01.2 — System Owner</div>
    <div class="r" style="display:grid;grid-template-columns:1fr 620px;gap:70px;align-items:start">
      <div>
        <h2 class="d">Ali Iman<br>Hassan</h2>
        <p class="tiny" style="margin-top:16px;color:var(--dim)">AI Strategist &amp; Copywriter · 3+ Years · Kolkata</p>
        <p class="lede" style="margin-top:26px">Three-plus years in AI-driven strategy, copywriting and digital marketing — building campaigns that are creatively compelling and commercially effective. Collaborations include SRMB Steel, Prabhuji and MP Birla Cement, delivering integrated digital strategies and on-ground activations.</p>
        <p class="lede" style="margin-top:16px">Expertise spans LinkedIn, Instagram, Facebook and Google My Business, with a consistent focus on brand authority, engagement and turning digital visibility into business outcomes.</p>
        <div style="margin-top:34px;display:flex;gap:10px;flex-wrap:wrap;max-width:560px">
          <span class="chip">Brand Strategy &amp; Creative Direction</span>
          <span class="chip">Market &amp; Competitor Analysis</span>
          <span class="chip">Social Media Campaign Concepts</span>
          <span class="chip">Visual Design &amp; Creative Editing</span>
          <span class="chip">AI-Powered Content Creation</span>
          <span class="chip">Cinematic AI Visual Production</span>
          <span class="chip">Content &amp; Article Development</span>
          <span class="chip">Creative Copywriting</span>
        </div>
      </div>
      <div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:2px;background:var(--line)">
          <div class="node" style="border:0;padding:26px 24px"><div class="k">Clients handled</div><div class="v" style="font-size:52px">31+</div></div>
          <div class="node" style="border:0;padding:26px 24px"><div class="k">Projects worked on</div><div class="v" style="font-size:52px">73+</div></div>
          <div class="node" style="border:0;padding:26px 24px"><div class="k">Scripts &amp; content written</div><div class="v" style="font-size:52px">101+</div></div>
          <div class="node" style="border:0;padding:26px 24px"><div class="k">Years of experience</div><div class="v" style="font-size:52px">3+</div></div>
        </div>
        <p class="tiny" style="margin-top:30px">Sectors worked across</p>
        <div style="margin-top:14px;font-family:var(--mono);font-size:12px;line-height:2.05;color:var(--dim)">
          <div><span class="hl">Infrastructure</span> — SRMB · SRMB RealEdge · SRMB RealFabrica · MP Birla Cement · Realbuild</div>
          <div><span class="hl">Real Estate</span> — Srijan · Joyville by Shapoorji Pallonji · Natura · Fortune Heights</div>
          <div><span class="hl">Hospitality</span> — Viceroy · Jhore Jole Jongole · Suites by Offbeat · Hide Away</div>
          <div><span class="hl">Food &amp; Beverage</span> — Prabhuji · Coftea · The Biryani Canteen · Café Offbeat</div>
          <div><span class="hl">Electronics</span> — Acumen · Wild Waves · Regler · Phasemount</div>
          <div><span class="hl">Multi-sector</span> — Mediseba · DCVision VR · BNI · AFS · Shiny Petals · Vadhuu</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 03 HOW I WORK ============ -->
  <section class="slide" data-ch="02" data-label="How I Work">
    <div class="eyebrow r">02 — A day on the system</div>
    <h2 class="d r" style="max-width:900px">This is how AI<br>fits into my day.</h2>
    <div class="r" style="margin-top:52px;position:relative">
      <div style="position:absolute;left:0;right:0;top:64px;height:1px;background:linear-gradient(90deg,rgba(61,123,255,.15),rgba(61,123,255,.55),rgba(138,92,246,.55),rgba(138,92,246,.15))"></div>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:2px">
        <div style="padding-right:26px">
          <div class="tiny" style="color:#7FA6FF">06:30 — 11:00</div>
          <h3 class="d" style="margin-top:12px">Morning</h3>
          <div style="height:26px"></div>
          <div style="font-family:var(--mono);font-size:12.5px;line-height:2.2;color:var(--dim)">
            <div><span class="hl">Research</span> — category &amp; brand context</div>
            <div><span class="hl">Trends</span> — what's performing this week</div>
            <div><span class="hl">Competitor scan</span> — feeds, ads, tone</div>
            <div><span class="hl">Ideas</span> — raw angles, no filter</div>
          </div>
          <p class="tiny" style="margin-top:22px;color:var(--dimmer)">ChatGPT · Gemini · Google AI Studio</p>
        </div>
        <div style="padding-right:26px">
          <div class="tiny" style="color:#8FB0FF">11:00 — 15:00</div>
          <h3 class="d" style="margin-top:12px">Midday</h3>
          <div style="height:26px"></div>
          <div style="font-family:var(--mono);font-size:12.5px;line-height:2.2;color:var(--dim)">
            <div><span class="hl">Strategy</span> — the one thing to say</div>
            <div><span class="hl">Copy</span> — headlines, VO, captions</div>
            <div><span class="hl">Content planning</span> — calendar &amp; pillars</div>
            <div><span class="hl">Visual concepts</span> — frame creation</div>
          </div>
          <p class="tiny" style="margin-top:22px;color:var(--dimmer)">ChatGPT · Gemini</p>
        </div>
        <div style="padding-right:26px">
          <div class="tiny" style="color:#A79BFF">15:00 — 19:00</div>
          <h3 class="d" style="margin-top:12px">Afternoon</h3>
          <div style="height:26px"></div>
          <div style="font-family:var(--mono);font-size:12.5px;line-height:2.2;color:var(--dim)">
            <div><span class="hl">Prompting</span> — scene by scene</div>
            <div><span class="hl">Image generation</span> — frames &amp; moodboards</div>
            <div><span class="hl">Video</span> — motion, voice, sound</div>
            <div><span class="hl">Editing</span> — cut, grade, caption</div>
          </div>
          <p class="tiny" style="margin-top:22px;color:var(--dimmer)">Midjourney · Flow AI · ElevenLabs · VEED.IO</p>
        </div>
        <div>
          <div class="tiny" style="color:#B49BFF">19:00 — 22:00</div>
          <h3 class="d" style="margin-top:12px">Evening</h3>
          <div style="height:26px"></div>
          <div style="font-family:var(--mono);font-size:12.5px;line-height:2.2;color:var(--dim)">
            <div><span class="hl">Scheduling</span> — the week ahead</div>
            <div><span class="hl">Publishing</span> — across platforms</div>
            <div><span class="hl">Analytics</span> — what actually landed</div>
            <div><span class="hl">Optimization</span> — feed it back tomorrow</div>
          </div>
          <p class="tiny" style="margin-top:22px;color:var(--dimmer)">Meta Business Suite</p>
        </div>
      </div>
    </div>
    <p class="lede r" style="margin-top:54px;max-width:840px">No part of the day is "the AI part". It is a layer under all of it — research runs faster, options multiply, and the judgement stays mine.</p>
  </section>

  <!-- ============ 04 IDEA MACHINE ============ -->
  <section class="slide" data-ch="03" data-label="Idea Machine">
    <div class="eyebrow r">03 — The idea machine</div>
    <div class="r" style="display:grid;grid-template-columns:600px 1fr;gap:90px;align-items:center;margin-top:6px">
      <div>
        <h2 class="d" style="font-size:60px">AI helps me<br>explore more<br>before I commit<br>to one idea.</h2>
        <p class="lede" style="margin-top:30px">The bottleneck was never execution. It was how few directions you could realistically test before the deadline forced your hand. Now the funnel starts wider — and the idea that survives has beaten more competition.</p>
        <p class="tiny" style="margin-top:28px;color:var(--dimmer)">Applied on: Prabhuji Rakhi film · Coftea Holi · SRMB brand story · Joyville paid ads</p>
      </div>
      <div>
        <div class="funnel" style="display:flex;flex-direction:column;gap:8px;align-items:center">
          <div class="node act" style="width:100%;text-align:center"><div class="k">Input</div><div class="v">One brief</div></div>
          <div class="tiny" style="color:var(--dimmer)">↓</div>
          <div class="node" style="width:88%;text-align:center"><div class="k">Layer 01</div><div class="v">AI research</div></div>
          <div class="tiny" style="color:var(--dimmer)">↓</div>
          <div class="node" style="width:76%;text-align:center"><div class="k">Layer 02</div><div class="v">10 ideas</div></div>
          <div class="tiny" style="color:var(--dimmer)">↓</div>
          <div class="node" style="width:60%;text-align:center"><div class="k">Layer 03</div><div class="v">3 creative directions</div></div>
          <div class="tiny" style="color:var(--dimmer)">↓</div>
          <div class="node act" style="width:44%;text-align:center"><div class="k">Layer 04</div><div class="v">1 strong concept</div></div>
          <div class="tiny" style="color:var(--dimmer)">↓</div>
          <div style="width:34%;text-align:center;padding:16px 20px;border:1px solid rgba(138,92,246,.55);
            background:linear-gradient(180deg,rgba(138,92,246,.16),rgba(61,123,255,.06));box-shadow:var(--glow)">
            <div class="k mono" style="font-size:10px;letter-spacing:.24em;color:#C6B7FF">Output</div>
            <div class="v" style="font-family:var(--disp);font-size:22px;letter-spacing:.03em;margin-top:8px">Campaign</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 05 THOUGHT TO PROMPT ============ -->
  <section class="slide" data-ch="04" data-label="Thought → Prompt">
    <div class="eyebrow r">04 — From thought to prompt</div>
    <h2 class="d r" style="max-width:1050px;font-size:64px">The prompt is where<br>strategy becomes visual.</h2>
    <div class="r" style="margin-top:44px;display:flex;align-items:center;gap:0">
      <div class="node" style="flex:1"><div class="k">01</div><div class="v" style="font-size:17px">Client brief</div></div>
      <div class="arrow">→</div>
      <div class="node" style="flex:1"><div class="k">02</div><div class="v" style="font-size:17px">Human thinking</div></div>
      <div class="arrow">→</div>
      <div class="node" style="flex:1"><div class="k">03</div><div class="v" style="font-size:17px">Creative idea</div></div>
      <div class="arrow">→</div>
      <div class="node act" style="flex:1"><div class="k">04</div><div class="v" style="font-size:17px">Prompt</div></div>
      <div class="arrow">→</div>
      <div class="node" style="flex:1"><div class="k">05</div><div class="v" style="font-size:17px">AI generation</div></div>
      <div class="arrow">→</div>
      <div class="node" style="flex:1"><div class="k">06</div><div class="v" style="font-size:17px">Art direction</div></div>
      <div class="arrow">→</div>
      <div class="node" style="flex:1"><div class="k">07</div><div class="v" style="font-size:17px">Final visual</div></div>
    </div>
    <div class="r" style="margin-top:32px;display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:start">
      <div class="panel" style="padding:24px 28px;min-height:286px">
        <p class="tiny" style="color:#7FA6FF">Live example — MP Birla Cement · Rakshak · Scene 01</p>
        <p style="margin-top:18px;font-size:14px;line-height:1.75;color:var(--dim)">
          <span class="tiny" style="display:block;margin-bottom:6px">Script line</span>
          <span class="hl">“Kabhi socha hai, zindagi kitni sukoon bhari ho sakti hai… jab sab kuch perfect ho?”</span>
        </p>
        <p style="margin-top:22px;font-family:var(--mono);font-size:12.5px;line-height:1.85;color:#9FB4DC;
          border-left:2px solid var(--violet);padding-left:16px">
          <span class="tiny" style="display:block;margin-bottom:8px;border:0;padding:0">Prompt</span>
          Wide cinematic shot of an Indian man in his 30s standing on a snowy mountain cliff, arms spread, smiling as snowflakes gently fall on his face. Soft, dreamy lighting, cinematic tones, shallow depth of field, peaceful surreal atmosphere.
        </p>
      </div>
      <div class="frame" style="height:286px">
        <Image src={portfolioImages[0]} alt="Visual and prompt breakdown sheet for the Rakshak Cement film" />
        <div class="cap">Visual &amp; prompt breakdown · scene-by-scene · MP Birla Cement</div>
      </div>
    </div>
    <p class="tiny r" style="margin-top:20px;color:var(--dimmer)">Copy first, then shot description, then prompt — the strategy has to survive all three translations.</p>
  </section>

  <!-- ============ 06 AI FILMMAKING ============ -->
  <section class="slide" data-ch="05" data-label="AI Filmmaking">
    <div style="position:absolute;inset:0;z-index:0;background:
      radial-gradient(70% 60% at 78% 40%, rgba(138,92,246,.13), transparent 70%)"></div>
    <div style="position:relative;z-index:2">
      <div class="eyebrow r">05 — AI filmmaking</div>
      <div class="r" style="display:grid;grid-template-columns:640px 1fr;gap:80px;align-items:center">
        <div>
          <h2 class="d grad" style="font-size:92px">From a<br>sentence<br>to a scene.</h2>
          <p class="lede" style="margin-top:32px">A film used to need a crew, a location and a budget before anyone could see whether the idea worked. Now the idea can be seen on the same day it is written — and only the ideas that survive that test go forward.</p>
          <p class="tiny" style="margin-top:26px;color:var(--dimmer)">Films built this way: Prabhuji Rakhi · MP Birla Rakshak YouTube ad · SRMB brand story · ZEE5 topical · Coftea Holi &amp; Mother's Day</p>
        </div>
        <div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:2px;background:var(--line)">
            <div class="node" style="border:0"><div class="k">Step 01</div><div class="v" style="font-size:19px">Idea</div></div>
            <div class="node" style="border:0"><div class="k">Step 02</div><div class="v" style="font-size:19px">Script</div></div>
            <div class="node" style="border:0"><div class="k">Step 03</div><div class="v" style="font-size:19px">Storyboard</div></div>
            <div class="node" style="border:0"><div class="k">Step 04</div><div class="v" style="font-size:19px">Shot design</div></div>
            <div class="node act" style="border:0"><div class="k">Step 05</div><div class="v" style="font-size:19px">AI visuals</div></div>
            <div class="node act" style="border:0"><div class="k">Step 06</div><div class="v" style="font-size:19px">Motion</div></div>
            <div class="node" style="border:0"><div class="k">Step 07</div><div class="v" style="font-size:19px">Edit</div></div>
            <div class="node" style="border:0;background:linear-gradient(135deg,rgba(61,123,255,.18),rgba(138,92,246,.14))">
              <div class="k">Step 08</div><div class="v" style="font-size:19px">Final film</div></div>
          </div>
          <div style="margin-top:26px;display:flex;gap:8px;flex-wrap:wrap">
            <span class="chip">Camera language</span><span class="chip">Lighting design</span>
            <span class="chip">Continuity of cast</span><span class="chip">VO &amp; sound</span>
            <span class="chip">Vertical &amp; horizontal cuts</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 07 FILM CASE: PRABHUJI ============ -->
  <section class="slide" data-ch="05" data-label="Film · Prabhuji">
    <div class="eyebrow r">05.2 — AI film case · Prabhuji · Raksha Bandhan</div>
    <div class="r" style="display:grid;grid-template-columns:430px 1fr;gap:56px;align-items:start">
      <div>
        <h3 class="d">Rishtey mein thodi masti,<br>Rakhi mein thodi mithaas</h3>
        <p class="lede" style="margin-top:22px;font-size:16px">A brother-and-sister film built on banter and leg-pulling — the sister unimpressed, the brother late and empty-handed, until two boxes of Soan Papdi and Kaju Barfi appear from behind his back. No matter how much siblings argue, mithaas always wins.</p>
        <div style="margin-top:26px;font-family:var(--mono);font-size:12px;line-height:2;color:var(--dim)">
          <div><span class="hl">Idea</span> → everyday realism + festive warmth</div>
          <div><span class="hl">Script</span> → rhyming dialogue, two characters, one room</div>
          <div><span class="hl">Shots</span> → generated scene-wise, cast kept consistent</div>
          <div><span class="hl">Super</span> → Prabhuji – Mithaas Jo Rishtey Banaye</div>
        </div>
        <p style="margin-top:26px;font-family:var(--disp);font-size:22px;line-height:1.3;text-transform:uppercase;letter-spacing:.02em;color:#C6D2EA">
          “Bandhan pyaar ka, mithaas Prabhuji ki — iss Rakhi dono ko banaiyein yaadgaar”</p>
      </div>
      <div>
        <p class="tiny" style="margin-bottom:14px">Script-wise AI film raw shots — parts 01 → 03</p>
        <div style="display:grid;grid-template-columns:1fr;gap:12px">
          <div class="frame" style="height:180px"><Image src={portfolioImages[1]} alt="Prabhuji Rakhi film raw shots part 1" /><div class="cap">Part 01 · setup — the unimpressed sister, the late brother</div></div>
          <div class="frame" style="height:180px"><Image src={portfolioImages[2]} alt="Prabhuji Rakhi film raw shots part 2" /><div class="cap">Part 02 · turn — the sweets appear</div></div>
          <div class="frame" style="height:180px"><Image src={portfolioImages[3]} alt="Prabhuji Rakhi film raw shots part 3" /><div class="cap">Part 03 · resolve — end card</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 08 CONTENT ENGINE ============ -->
  <section class="slide" data-ch="06" data-label="Content Engine">
    <div class="eyebrow r">06 — The content engine</div>
    <h2 class="d r">One idea. Multiple expressions.</h2>
    <div class="r" style="margin-top:48px;display:grid;grid-template-columns:330px 1fr;gap:64px;align-items:center">
      <div>
        <div style="padding:26px 24px;border:1px solid rgba(61,123,255,.5);
