<script>
(function(){
  var stage = document.getElementById('stage') as HTMLElement;
  var viewport = document.getElementById('viewport') as HTMLElement;
  var slides = Array.prototype.slice.call(document.querySelectorAll<HTMLElement>('.slide')) as HTMLElement[];
  var track = document.getElementById('track') as HTMLElement;
  var idxEl = document.getElementById('idx') as HTMLElement;
  var totalEl = document.getElementById('total') as HTMLElement;
  var chapterEl = document.getElementById('chapterName') as HTMLElement;
  var tcEl = document.getElementById('tc') as HTMLElement;
  var hintbar = document.getElementById('hintbar') as HTMLElement;
  var cur = 0;
  var mobileMedia = window.matchMedia('(max-width:720px)');

  function pad(n: number): string { const value = String(n); return value.length < 2 ? '0'+value : value; }
  totalEl.textContent = pad(slides.length);

  // build timeline clips
  slides.forEach(function(s,i){
    var c = document.createElement('div');
    c.className = 'clip';
    var label = document.createElement('span');
    label.textContent = pad(i+1)+' · '+(s.getAttribute('data-label')||'');
    c.appendChild(label);
    c.addEventListener('click', function(){ go(i); });
    track.appendChild(c);
  });
  var clips = Array.prototype.slice.call(track.children);

  function tc(i: number): string {
    var totalFrames = Math.round(i * 312 + 84);
    var f = totalFrames % 24;
    var totalSec = Math.floor(totalFrames/24);
    var s = totalSec % 60;
    var m = Math.floor(totalSec/60) % 60;
    var h = Math.floor(totalSec/3600);
    return pad(h)+':'+pad(m)+':'+pad(s)+':'+pad(f);
  }

  function syncMobileChrome(){
    stage.classList.toggle('slide-scrolled', mobileMedia.matches && slides[cur].scrollTop > 12);
  }

  slides.forEach(function(s){
    s.addEventListener('scroll', syncMobileChrome, {passive:true});
  });

  function go(i: number): void {
    if(i<0) i=0;
    if(i>slides.length-1) i=slides.length-1;
    slides[cur].classList.remove('on');
    cur = i;
    slides[cur].classList.add('on');
    slides[cur].scrollTop = 0;
    syncMobileChrome();
    clips.forEach(function(c,n){
      c.classList.toggle('cur', n===cur);
      c.classList.toggle('done', n<cur);
    });
    idxEl.textContent = pad(cur+1);
    chapterEl.textContent = slides[cur].getAttribute('data-label')||'';
    tcEl.textContent = tc(cur);
    if(cur>0) hintbar.classList.add('gone');
  }

  document.addEventListener('keydown', function(e){
    if(e.key==='ArrowRight'||e.key==='PageDown'||e.key===' '){ e.preventDefault(); go(cur+1); }
    else if(e.key==='ArrowLeft'||e.key==='PageUp'){ e.preventDefault(); go(cur-1); }
    else if(e.key==='Home'){ go(0); }
    else if(e.key==='End'){ go(slides.length-1); }
    else if(e.key==='f'||e.key==='F'){
      if(!document.fullscreenElement && document.documentElement.requestFullscreen){ document.documentElement.requestFullscreen(); }
      else if(document.exitFullscreen){ document.exitFullscreen(); }
    }
  });
  (document.getElementById('next') as HTMLButtonElement).addEventListener('click', function(){ go(cur+1); });
  (document.getElementById('prev') as HTMLButtonElement).addEventListener('click', function(){ go(cur-1); });

  var wheelLock = false;
  viewport.addEventListener('wheel', function(e){
    if(Math.abs(e.deltaY) < 18) return;
    if(wheelLock) return;
    wheelLock = true;
    setTimeout(function(){ wheelLock = false; }, 700);
    go(cur + (e.deltaY>0?1:-1));
  }, {passive:true});

  var tsx=0, tsy=0;
  viewport.addEventListener('touchstart', function(e){ tsx=e.touches[0].clientX; tsy=e.touches[0].clientY; }, {passive:true});
  viewport.addEventListener('touchend', function(e){
    var dx = e.changedTouches[0].clientX - tsx;
    var dy = e.changedTouches[0].clientY - tsy;
    if(Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy)) go(cur + (dx<0?1:-1));
  }, {passive:true});

  function fit(){
    if(window.matchMedia('(max-width:720px)').matches){
      stage.style.setProperty('--s', '1');
      return;
    }
    var s = Math.min(window.innerWidth/1600, window.innerHeight/900);
    s = Math.max(s, 0.26);
    stage.style.setProperty('--s', String(s));
  }
  window.addEventListener('resize', fit);
  fit();
  go(0);
})();
</script>
